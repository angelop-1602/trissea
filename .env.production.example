# Runtime
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://your-app-domain.com

# Database (Supabase Postgres)
DATABASE_URL="postgresql://<db-user>:<db-password>@<db-host>:6543/postgres?pgbouncer=true"

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>

# Optional observability / hardening
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Rate-limit tuning
BOOKING_RATE_LIMIT_BURST=1
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Routing
# Use GraphHopper for stricter public-road route validation. For self-hosting,
# set GRAPHHOPPER_ROUTE_URL to your route endpoint and leave the API key blank.
ROUTING_PROVIDER=graphhopper
GRAPHHOPPER_API_KEY=
GRAPHHOPPER_ROUTE_URL=
GRAPHHOPPER_PROFILE=car
ROUTING_ALLOW_OSRM_FALLBACK=false
ROUTING_DISALLOWED_ROAD_CLASSES=service,track,path,footway,pedestrian,steps
ROUTING_MAX_DISALLOWED_ROAD_CLASS_METERS=30

# Admin credentials (email login)
ADMIN_EMAIL=admin@trissea.local
ADMIN_PASSWORD=change-me-admin-password
SUPERADMIN_EMAIL=superadmin@trissea.local
SUPERADMIN_PASSWORD=change-me-superadmin-password
